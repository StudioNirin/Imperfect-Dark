#ifndef _IN_TITLEAUDIODATA_H
#define _IN_TITLEAUDIODATA_H

// Generated by CMake from port/audio/title-screen.mp3 when it configures, and
// again whenever that file changes. Included by port/src/sndfile.c alone, so a
// new sound rebuilds one file rather than the whole game the way
// versioninfo.h would.

// The sound the title screen plays when there is no data/sfx/title-screen.*
// beside the game. An update replaces only the executable, so carrying it here
// is what makes a changed sound reach players who already have the game.
static const unsigned char g_TitleScreenAudioBuiltIn[] = { @TITLE_AUDIO_BYTES@0x00 };
static const unsigned int g_TitleScreenAudioBuiltInSize = @TITLE_AUDIO_SIZE@;

#endif