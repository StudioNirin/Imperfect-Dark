# Copy to .env and fill in. Compose reads it automatically.

# The domain whose A record points at this machine; Caddy gets a Let's
# Encrypt certificate for it on first up. Players put
# https://THIS/pdlobby in Net.LobbyServer.
LOBBY_DOMAIN=lobby.example.org

# Let's Encrypt contact address (renewal trouble mail). Anything that is a
# real-enough address; it is not shown to players.
#LOBBY_TLS_EMAIL=admin@example.org

# pdlobbyd's HTTP port on the loopback (only Caddy talks to it) and the UDP
# rendezvous port on every address (this one is in the punch protocol's
# answer to every client, so a player's firewall has to allow it).
#LOBBY_HTTP_PORT=8091
#LOBBY_UDP_PORT=27101

# "open": any player name, no account, no PIN - one command to start playing
# and nothing to hand out. "ghost": names and PINs from a pdghostd (see
# tools/pdghostd; it needs its own service here too). Anyone can claim any
# name in an open lobby, so only the people you would hand a LAN password to
# get the URL.
LOBBY_AUTH=open

# The relay's port range for pairs whose NATs will not punch. Keep it at the
# default 32 unless the crowd grows; it is UDP and must be open too.
#LOBBY_RELAY_PORTS=27110-27141
